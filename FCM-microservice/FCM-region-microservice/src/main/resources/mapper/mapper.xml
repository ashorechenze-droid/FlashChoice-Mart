<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fcmregionmicroservice.mapper.RegionMapper">
    <!-- 通用查询列（t_china_region 无审计字段） -->
    <sql id="Base_Select">
        select id,
               name,
               parent_id,
               sort_order,
               level,
               description
        from t_china_region
    </sql>
    <select id="findAll" resultType="com.example.fcmspi.model.ChinaRegionEntity">
        <include refid="Base_Select"/>
        order by parent_id, sort_order, id
    </select>
    <select id="findByParentId" resultType="com.example.fcmspi.model.ChinaRegionEntity">
        <include refid="Base_Select"/>
        where parent_id = #{parentId}
        order by sort_order, id
    </select>
</mapper>
