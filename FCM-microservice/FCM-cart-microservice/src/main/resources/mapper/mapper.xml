<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fcmcartmicroservice.mapper.CartMapper">
    <!-- 通用查询列（cart 无审计字段） -->
    <sql id="Base_Select">
        select id,
               member_id,
               good_id,
               qty
        from cart
    </sql>
    <select id="findByMemberId" resultType="com.example.fcmspi.model.CartEntity">
        <include refid="Base_Select"/>
        where member_id = #{memberId}
        order by id desc
    </select>
    <select id="findByIds" resultType="com.example.fcmspi.model.CartEntity">
        <include refid="Base_Select"/>
        where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </select>
    <select id="findById" resultType="com.example.fcmspi.model.CartEntity">
        <include refid="Base_Select"/>
        where id = #{id}
    </select>
    <select id="findByMemberAndGood" resultType="com.example.fcmspi.model.CartEntity">
        <include refid="Base_Select"/>
        where member_id = #{memberId} and good_id = #{goodId}
    </select>
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into cart (member_id, good_id, qty)
        values (#{memberId}, #{goodId}, #{qty})
    </insert>
    <update id="updateQty">
        update cart
        set qty = #{qty}
        where id = #{id} and member_id = #{memberId}
    </update>
    <delete id="deleteByIds">
        delete from cart
        where member_id = #{memberId}
        and id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
