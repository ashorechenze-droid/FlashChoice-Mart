<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fcmcollectmicroservice.mapper.CollectMapper">
    <!-- 通用查询列（collect 无审计字段） -->
    <sql id="Base_Select">
        select id,
               member_id,
               good_id
        from collect
    </sql>
    <select id="findByMemberId" resultType="com.example.fcmspi.model.CollectEntity">
        <include refid="Base_Select"/>
        where member_id = #{memberId}
        order by id desc
    </select>
    <select id="findByMemberAndGood" resultType="com.example.fcmspi.model.CollectEntity">
        <include refid="Base_Select"/>
        where member_id = #{memberId} and good_id = #{goodId}
    </select>
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into collect (member_id, good_id)
        values (#{memberId}, #{goodId})
    </insert>
    <delete id="deleteByIds">
        delete from collect
        where member_id = #{memberId}
        and id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>
    <delete id="deleteByMemberAndGood">
        delete from collect
        where member_id = #{memberId} and good_id = #{goodId}
    </delete>
    <select id="findMemberIdsByGoodId" resultType="long">
        select member_id
        from collect
        where good_id = #{goodId}
    </select>
</mapper>
